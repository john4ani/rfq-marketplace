# Reference for deploy/docker-compose.yml backend-prod container environment.
# The deploy pipeline renders .env.prod from AWS SSM via deploy/scripts/render-environment.sh;
# this file documents the same variable contract for a manual or reference deploy.
# Placeholders are rejected by the API at boot — replace them before use.

API_ORIGIN_HOST=compaspot.com
FRONTEND_ORIGIN=https://compaspot.com
AllowedHosts=compaspot.com
ConnectionStrings__MarketplaceDatabase=Host=postgres;Port=5432;Database=compaspot_prod;Username=marketplace;Password=replace-with-the-postgres-password
DataProtection__KeysPath=/var/lib/marketplace/data-protection-keys
Jwt__Issuer=rfq-marketplace-api
Jwt__Audience=rfq-marketplace-web
Jwt__SigningKey=replace-with-at-least-32-random-bytes

AiIntake__Enabled=true
AiIntake__Provider=OpenAi
AiIntake__ApiKey=replace-with-openai-api-key
AiIntake__Endpoint=https://api.openai.com/v1/responses
AiIntake__Model=gpt-5.6-luna

GooglePlaces__Enabled=true
GooglePlaces__ApiKey=replace-with-google-places-api-key
GooglePlaces__TextSearchEndpoint=https://places.googleapis.com/v1/places:searchText
GooglePlaces__NearbySearchEndpoint=https://places.googleapis.com/v1/places:searchNearby
GooglePlaces__GeocodingEndpoint=https://maps.googleapis.com/maps/api/geocode/json

Email__Enabled=true
Email__Host=smtp-relay.gmail.com
Email__Port=587
Email__UseTls=true
Email__Username=replace-with-ses-smtp-username
Email__Password=replace-with-ses-smtp-password
Email__FromAddress=john4ani@gmail.com
Email__FromName=CompaSpot
Email__ReplyToAddress=support@compaspot.com

# V3 safety switches — keep false until the module is intentionally enabled.
Features__SeapIngestionEnabled=false
Features__AutoBiddingEnabled=false

Seap__Enabled=false
Seap__BaseUrl=https://e-licitatie.ro
Seap__NoticesPath=api-pub/NoticeCommon/GetCNoticeList/
Seap__NoticeTypeIds__0=2
Seap__NoticesPageSize=20
Seap__PollingIntervalSeconds=3600
Seap__TargetCpvPrefixes__0=
Seap__MaxNoticesPerPoll=20
Seap__MaxNewNoticesPerHour=5
Seap__RequestTimeoutSeconds=60
Seap__Storage__Enabled=false
Seap__Storage__Bucket=compaspot-data
Seap__Storage__Region=eu-central-1

AutoBidding__IsShadowMode=true
AutoBidding__Model=claude-3-5-sonnet
AutoBidding__ApiKey=replace-with-anthropic-api-key
AutoBidding__ApiUrl=https://api.anthropic.com/v1/messages
AutoBidding__MaxRequestTokens=4000
AutoBidding__TopChunks=10
AutoBidding__EmbeddingModel=text-embedding-3-small
AutoBidding__EmbeddingEndpoint=https://api.openai.com/v1/embeddings
AutoBidding__EmbeddingApiKey=replace-with-openai-api-key
AutoBidding__DocumentsBucket=compaspot-data
AutoBidding__DocumentsRegion=eu-central-1

Stripe__Enabled=false
Stripe__ApiKey=replace-with-stripe-secret-key
Stripe__WebhookSecret=replace-with-stripe-webhook-secret

DocumentIntelligence__Enabled=false
DocumentIntelligence__Endpoint=replace-with-azure-document-intelligence-endpoint
DocumentIntelligence__ApiKey=replace-with-azure-document-intelligence-key

# Cloudflare R2 (S3-compatible). Empty ServiceUrl = AWS S3 with IAM; set to the R2 endpoint to target R2.
S3__ServiceUrl=https://replace-with-r2-account-id.r2.cloudflarestorage.com
S3__AccessKeyId=replace-with-r2-access-key-id
S3__SecretAccessKey=replace-with-r2-secret-access-key
S3__Region=auto
S3__RootPrefix=prod

ReverseProxy__KnownProxies__0=172.28.0.2
