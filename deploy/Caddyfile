{
	email {$ACME_EMAIL}
	admin off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

# Public Prod site: SPA served by Caddy, API + health proxied to backend-prod.
# Let's Encrypt issues the certificate automatically for both names.
# "3-64-174-227.sslip.io" is the legacy CloudFront origin hostname — it keeps the live API working
# during the cutover window (CloudFront → Lightsail). Remove it after the DNS repoint + CloudFront cleanup.
{$PROD_SITE:compaspot.com}, www.compaspot.com, 3-64-174-227.sslip.io {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	root * /srv/www-prod

	@api path /api/* /health/*
	handle @api {
		reverse_proxy backend-prod:8080
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

# Staging site: NOT public — plain HTTP on :8081, reachable only from the admin CIDR
# (Lightsail firewall rule). No TLS because no public domain is attached to Staging.
:8081 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	root * /srv/www-staging

	@api path /api/* /health/*
	handle @api {
		reverse_proxy backend-staging:8080
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
