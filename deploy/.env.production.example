# Production environment for deploy/compose.production.yaml.
# The automated pipeline renders the real .env from AWS SSM via deploy/scripts/render-environment.sh;
# this file documents the same variable contract for a manual or reference deploy.
# Replace every "replace-with-..." placeholder before use — the API rejects placeholder values at boot.

API_IMAGE=rfq-marketplace-api:replace-with-commit-sha
API_ORIGIN_HOST=api.example.com
FRONTEND_ORIGIN=https://app.example.com
ACME_EMAIL=operations@example.com
DATA_PROTECTION_KEYS_PATH=./.data-protection-keys

POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=replace-with-a-random-password
MARKETPLACE_DATABASE_CONNECTION=Host=postgres;Port=5432;Database=marketplace;Username=marketplace;Password=replace-with-the-same-random-password

JWT_ISSUER=rfq-marketplace-api
JWT_AUDIENCE=rfq-marketplace-web
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes

# Transactional email. Set EMAIL_ENABLED=false to run without email; when true, every EMAIL_* below is required.
# EMAIL_USERNAME/EMAIL_PASSWORD are optional as a pair (leave both empty for IP-authenticated SMTP relay).
EMAIL_ENABLED=true
EMAIL_HOST=email-smtp.eu-central-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=replace-with-ses-smtp-username
EMAIL_PASSWORD=replace-with-ses-smtp-password
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=CompaSpot
EMAIL_REPLY_TO_ADDRESS=support@example.com

# AI intake (OpenAI Responses API). Leave AI_INTAKE_API_KEY empty to run without AI assistance.
AI_INTAKE_PROVIDER=OpenAi
AI_INTAKE_API_KEY=replace-with-openai-api-key
AI_INTAKE_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
AI_INTAKE_MODEL=gpt-5.6-luna

# Google Maps Platform — Places API (New), used only by bounded Supplier Discovery.
# Keep the key in AWS SSM/local user secrets; never commit it here.
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
GOOGLE_PLACES_TEXT_SEARCH_ENDPOINT=https://places.googleapis.com/v1/places:searchText
GOOGLE_PLACES_NEARBY_SEARCH_ENDPOINT=https://places.googleapis.com/v1/places:searchNearby
GOOGLE_PLACES_GEOCODING_ENDPOINT=https://maps.googleapis.com/maps/api/geocode/json

# ===== V3 — Anunțuri SEAP / Auto-bidding =====
# Master safety switches: keep false at deploy time; toggle to true only when the V3 module is enabled.
# In appsettings.json these flags reload on change (no redeploy); on the host they come from SSM/.env.
FEATURES_SEAP_INGESTION_ENABLED=false
FEATURES_AUTO_BIDDING_ENABLED=false

# Every V3 feature is OFF by default; leave credentials empty to keep them off.
# The public SEAP endpoint (anonymous) serves a stale, capped dataset; structure is the real wire contract.

# SEAP ingestion worker (polls the public notice-search API and imports target notices through staging).
SEAP_ENABLED=false
SEAP_BASE_URL=https://e-licitatie.ro
SEAP_NOTICES_PATH=api-pub/NoticeCommon/GetCNoticeList/
SEAP_NOTICE_TYPE_ID=2
SEAP_NOTICES_PAGE_SIZE=20
SEAP_POLLING_INTERVAL_SECONDS=3600
SEAP_TARGET_CPV_PREFIX=
SEAP_MAX_NOTICES_PER_POLL=20
SEAP_MAX_NEW_NOTICES_PER_HOUR=5
SEAP_REQUEST_TIMEOUT_SECONDS=60
# S3 storage for downloaded SEAP attachments.
SEAP_STORAGE_ENABLED=false
SEAP_STORAGE_BUCKET=
SEAP_STORAGE_REGION=eu-central-1

# Auto-bidding pipeline (embeddings + Claude + S3). IsShadowMode generates without Stripe charging.
AUTO_BIDDING_IS_SHADOW_MODE=false
AUTO_BIDDING_MODEL=claude-3-5-sonnet
AUTO_BIDDING_API_KEY=replace-with-anthropic-api-key
AUTO_BIDDING_API_URL=https://api.anthropic.com/v1/messages
AUTO_BIDDING_MAX_REQUEST_TOKENS=8000
AUTO_BIDDING_TOP_CHUNKS=10
AUTO_BIDDING_EMBEDDING_MODEL=text-embedding-3-small
AUTO_BIDDING_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
AUTO_BIDDING_EMBEDDING_API_KEY=replace-with-openai-api-key
AUTO_BIDDING_DOCUMENTS_BUCKET=replace-with-s3-bucket-for-generated-bids
AUTO_BIDDING_DOCUMENTS_REGION=eu-central-1

# Stripe checkout for paid auto-bids; SuccessUrl/CancelUrl derive from FRONTEND_ORIGIN.
STRIPE_ENABLED=false
STRIPE_API_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret

# Azure Document Intelligence OCR for Company Vault PDF uploads.
DOCUMENT_INTELLIGENCE_ENABLED=false
DOCUMENT_INTELLIGENCE_ENDPOINT=replace-with-azure-document-intelligence-endpoint
DOCUMENT_INTELLIGENCE_API_KEY=replace-with-azure-document-intelligence-key
