admin_cidr        = "203.0.113.10/32"
acme_email        = "operations@example.com"
smtp_from_address = "no-reply@example.com"

# Optional Route 53 custom-domain configuration. Without it, staging uses the CloudFront
# domain for the frontend and <static-ip>.sslip.io for the API origin.
# root_domain    = "example.com"
# hosted_zone_id = "Z0123456789EXAMPLE"

# For a domain hosted outside Route 53, validate an ACM certificate manually in the
# external DNS provider and provide its issued us-east-1 ARN here.
# frontend_domain          = "example.com"
# frontend_aliases         = ["www.example.com"]
# frontend_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/example"
