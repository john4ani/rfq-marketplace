{
  "ConnectionStrings": {
    "MarketplaceDatabase": "Host=localhost;Port=5432;Database=marketplace;Username=marketplace;Password=marketplace-local-only"
  },
  "Storage": {
    "UseLocalStorage": true,
    "LocalPath": "App_Data/Storage"
  },
  "AI": {
    "UseMockProvider": false
  },
  "AutoBidding": {
    "IsShadowMode": true,
    "Model": "claude-sonnet-5",
    "MaxRequestTokens": 8000
  },
  "Features": {
    "SeapDirectHitEnabled": true,
    "SeapIngestionWorkerEnabled": true,
    "AutoBiddingEnabled": true,
    "MarketPlaceEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
