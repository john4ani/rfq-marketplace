POST {{Marketplace.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

###

POST {{Marketplace.Api_HostAddress}}/api/v1/auth/refresh

###

GET {{Marketplace.Api_HostAddress}}/health/live
Accept: application/json

###

