{
  "AiIntake": {
    "Enabled": true,
    "Provider": "OpenAi",
    "ApiKey": "",
    "Endpoint": "https://api.openai.com/v1/responses",
    "Model": "gpt-5.6-luna",
    "ReasoningEffort": "none",
    "TextVerbosity": "low",
    "PromptVersion": "2026-08-08.1",
    "RequestTimeoutSeconds": 60
  },
  "GooglePlaces": {
    "Enabled": true,
    "ApiKey": "",
    "TextSearchEndpoint": "https://places.googleapis.com/v1/places:searchText",
    "NearbySearchEndpoint": "https://places.googleapis.com/v1/places:searchNearby",
    "GeocodingEndpoint": "https://maps.googleapis.com/maps/api/geocode/json",
    "MinimumTextResultsForNearbyFallback": 3,
    "RequestTimeoutSeconds": 20,
    "MaxResults": 5
  },
  "ConnectionStrings": {
    "MarketplaceDatabase": "Host=localhost;Port=5432;Database=marketplace;Username=marketplace;Password=replace-me"
  },
  "Frontend": { "Origin": "https://app.example.com" },
  "DataProtection": {
    "KeysPath": "/var/lib/marketplace/data-protection-keys"
  },
  "Jwt": {
    "Issuer": "rfq-marketplace-api",
    "Audience": "rfq-marketplace-web",
    "SigningKey": "replace-with-at-least-32-random-bytes",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "PasswordReset": {
    "ResetPageUrl": "https://app.example.com/reset-password"
  },
  "EmailVerification": {
    "ConfirmationPageUrl": "https://app.example.com/verify-email",
  },
  "Email": {
    "Enabled": true,
    "Host": "smtp-relay.gmail.com",
    "Port": 587,
    "UseTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "notifications@compaspot.com",
    "FromName": "CompaSpot",
    "ReplyToAddress": "support@compaspot.com"
  },
  "ReverseProxy": {
    "KnownProxies": [ "replace-with-caddy-container-ip" ]
  },
  "AllowedHosts": "api.example.com"
}
